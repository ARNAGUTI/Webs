---
import Icon from './Icon.astro';
import Pic from './Pic.astro';
import { ui, type Lang } from '../i18n/ui';
import { negocio, horario, servicios, grupos, resenas, precioTexto, foto, type FotoId } from '../data/negocio';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang];
const other: Lang = lang === 'es' ? 'ca' : 'es';
const hrefFor = (l: Lang) => (l === 'es' ? '/' : '/ca/');
const tel = `tel:${negocio.telefonoE164}`;
const wa = `https://wa.me/${negocio.whatsapp}`;
const ig = `https://www.instagram.com/${negocio.instagram}/`;
const v = negocio.valoracion;
const fill = (tpl: string, vars: Record<string, string | number>) => tpl.replace(/\{(\w)\}/g, (_, k) => String(vars[k] ?? ''));
const precio = (p: number | null) => precioTexto(p, lang);

// Galería: trabajos reales del salón.
const galeria: FotoId[] = ['lazo', 'alisado', 'espejo-ondas', 'semirecogido', 'trenzas-nina', 'trenzas-perlas'];
const pasos = ['servicio', 'dia', 'hora', 'datos'] as const;

const ordenDias = [1, 2, 3, 4, 5, 6, 0];
const tramosTexto = (d: number) => horario[d].map(([a, b]) => `${a} – ${b}`).join(' · ');
const cap = (x: string) => x.charAt(0).toUpperCase() + x.slice(1);
const horarioAgrupado: { dias: string; horas: string }[] = [];
for (let i = 0; i < ordenDias.length; ) {
  const d = ordenDias[i];
  let j = i;
  while (j + 1 < ordenDias.length && tramosTexto(ordenDias[j + 1]) === tramosTexto(d)) j++;
  const dias = i === j ? cap(t.diasCortos[d]) : `${cap(t.diasCortos[d])} – ${cap(t.diasCortos[ordenDias[j]])}`;
  horarioAgrupado.push({ dias, horas: horario[d].length ? tramosTexto(d) : t.visita.cerradoDia });
  i = j + 1;
}

const cliente = {
  lang,
  horario,
  servicios: servicios.map((s) => ({ id: s.id, min: s.min, nombre: t.servicios.nombres[s.id] })),
  whatsapp: negocio.whatsapp,
  negocio: { nombre: negocio.nombre, direccion: `${negocio.direccion.calle}, ${negocio.direccion.cp} ${negocio.direccion.ciudad}` },
  t: { dias: t.dias, diasCortos: t.diasCortos, meses: t.meses, hoy: t.hoy, manana: t.manana, cita: t.cita, visita: t.visita },
};
---
<div id="app" data-cliente={JSON.stringify(cliente)}>
  <a class="skip" href="#main">{t.skip}</a>

  <header class="top" data-top>
    <div class="top-in wrap">
      <a class="brand" href={hrefFor(lang)} aria-label="SempreDivas">Sempre Divas</a>
      <nav class="nav" aria-label="Menú">
        <a href="#cita">{t.nav.cita}</a>
        <a href="#servicios">{t.nav.servicios}</a>
        <a href="#trabajos">{t.nav.trabajos}</a>
        <a href="#visita">{t.nav.visita}</a>
      </nav>
      <div class="top-actions">
        <a class="lang" href={hrefFor(other)} hreflang={other} lang={other} data-lang>
          <span class="sr">{ui[other].nombreIdioma}</span><span aria-hidden="true">{other.toUpperCase()}</span>
        </a>
        <a class="btn btn-line btn-sm top-call" href={tel}><Icon name="phone" size={18} />{t.llamar}</a>
      </div>
    </div>
  </header>

  <main id="main">
    <!-- Portada: el rótulo negro de la fachada y el espejo ovalado del salón -->
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-in wrap">
        <div class="hero-copy">
          <h1 id="hero-title" class="wordmark">Sempre Divas<span class="sr"> · {t.pie.hecho}</span></h1>
          <p class="oficio" aria-hidden="true"><span class="orn"></span>{t.oficio}<span class="orn"></span></p>
          <p class="lead">{t.hero.lema}</p>
          <div class="hero-cta">
            <a class="btn btn-gold" href="#cita"><Icon name="calendar" size={20} />{t.hero.cta}</a>
            <a class="btn btn-line" href={wa} target="_blank" rel="noopener"><Icon name="chat" size={20} />{t.whatsapp}</a>
          </div>
          <ul class="hero-facts">
            <li>
              <a href={negocio.mapsUrl} target="_blank" rel="noopener" class="rating">
                <span class="stars" aria-hidden="true">{[0, 1, 2, 3, 4].map(() => <Icon name="star" size={15} />)}</span>
                <b>{v.nota}</b> {fill(t.hero.resenas, { n: v.resenas })}
              </a>
            </li>
            <li><Icon name="clock" size={17} /><span data-status>{t.hero.domingo}</span></li>
          </ul>
        </div>

        <figure class="mirror" data-tilt>
          <div class="mirror-glass">
            <Pic id="trenzas-perlas" alt={t.hero.espejo} sizes="(max-width: 760px) 70vw, 400px" eager />
            <span class="sheen" aria-hidden="true"></span>
          </div>
          <div class="medallion" aria-hidden="true">
            <Pic id="lazo" alt="" sizes="160px" eager />
          </div>
        </figure>
      </div>
    </section>

    <!-- Cinta del escaparate: la lista de servicios corriendo -->
    <div class="ticker" aria-hidden="true">
      <div class="ticker-track">
        {[0, 1].map(() => (
          <p>{servicios.map((s) => <><span>{t.servicios.nombres[s.id]}</span><i class="tk-dot"></i></>)}</p>
        ))}
      </div>
    </div>

    <!-- Nuestro salón -->
    <section class="casa" aria-labelledby="casa-title">
      <div class="wrap casa-in">
        <figure class="casa-foto" data-reveal>
          <Pic id="logo-marmol" alt={t.casa.foto} sizes="(max-width: 760px) 90vw, 380px" />
        </figure>
        <div class="casa-copy" data-reveal style="--d:120ms">
          <h2 id="casa-title">{t.casa.titulo}</h2>
          <p class="casa-text">{t.casa.texto}</p>
          <ul class="gestos">
            {t.casa.gestos.map((g) => <li>{g}</li>)}
          </ul>
          <blockquote class="casa-quote" lang="es">
            <p>“{resenas[1].t}”</p>
            <footer>{resenas[1].n}</footer>
          </blockquote>
        </div>
      </div>
    </section>

    <!-- Reserva -->
    <section id="cita" class="book" aria-labelledby="cita-title">
      <div class="wrap book-in">
        <div class="book-head">
          <h2 id="cita-title">{t.cita.titulo}</h2>
          <p>{t.cita.intro}</p>
        </div>

        <form class="booking" data-reserva novalidate>
          <div class="stations">
            <fieldset class="station" data-station="servicio">
              <legend><span class="st-n" aria-hidden="true">1</span>{t.cita.pasos.servicio}</legend>
              <div class="svc-pick">
                {grupos.map((g) => (
                  <div class="svc-group" role="group" aria-label={t.servicios.grupos[g]}>
                    <p class="svc-group-name" aria-hidden="true">{t.servicios.grupos[g]}</p>
                    {servicios.filter((s) => s.grupo === g).map((s) => (
                      <label class="svc">
                        <input type="radio" name="servicio" value={s.id} />
                        <span class="svc-name">{t.servicios.nombres[s.id]}</span>
                        <span class="svc-meta">{precio(s.precio) ? <b>{precio(s.precio)}</b> : t.cita.consultar}</span>
                      </label>
                    ))}
                  </div>
                ))}
              </div>
              <p class="err" data-err="servicio" role="alert"></p>
            </fieldset>

            <fieldset class="station" data-station="dia">
              <legend><span class="st-n" aria-hidden="true">2</span>{t.cita.pasos.dia}</legend>
              <div class="chips chips-days" data-days></div>
              <p class="err" data-err="dia" role="alert"></p>
            </fieldset>

            <fieldset class="station" data-station="hora">
              <legend><span class="st-n" aria-hidden="true">3</span>{t.cita.pasos.hora}</legend>
              <div class="chips chips-slots" data-slots><p class="hint">{t.cita.eligeDia}</p></div>
              <p class="hint small">{t.cita.comoFunciona}</p>
              <p class="err" data-err="hora" role="alert"></p>
            </fieldset>

            <fieldset class="station" data-station="datos">
              <legend><span class="st-n" aria-hidden="true">4</span>{t.cita.pasos.datos}</legend>
              <p class="welcome" data-hola hidden><span data-hola-text></span> <button type="button" class="linkish" data-olvidar>{t.cita.noSoy}</button></p>
              <div class="fields">
                <label class="field">
                  <span>{t.cita.nombre}</span>
                  <input name="nombre" type="text" autocomplete="given-name" required maxlength="40" />
                  <span class="err" data-err="nombre" role="alert"></span>
                </label>
                <label class="field">
                  <span>{t.cita.tel}</span>
                  <input name="tel" type="tel" inputmode="tel" autocomplete="tel" required maxlength="16" placeholder="600 000 000" />
                  <span class="err" data-err="tel" role="alert"></span>
                </label>
                <label class="field field-wide">
                  <span>{t.cita.nota}</span>
                  <input name="nota" type="text" maxlength="120" placeholder={t.cita.notaPh} />
                </label>
              </div>
              <label class="check"><input type="checkbox" name="recordar" checked /> <span>{t.cita.recordar}</span></label>
            </fieldset>
          </div>

          <!-- Tu cita: la tarjeta negra del salón, con el botón de enviar -->
          <aside class="mystrip" data-ticket aria-label={t.cita.tuTira}>
            <p class="ticket-title" aria-hidden="true">{t.cita.tuTira}</p>
            <ol class="mystrip-frames">
              {pasos.map((p, i) => (
                <li class="shot" data-shot={p} style={`--i:${i}`}>
                  <span class="shot-label">{t.cita.pasos[p]}</span>
                  <span class="shot-value" data-shot-value>{t.cita.vacio[p]}</span>
                </li>
              ))}
            </ol>
            <div class="mystrip-foot">
              <p class="summary is-empty" data-summary aria-live="polite">{t.cita.resumenVacio}</p>
              <button class="btn btn-gold btn-send" type="submit"><Icon name="chat" size={20} /><span>{t.cita.enviar}</span></button>
              <a class="call-alt" href={tel}>{t.cita.llamarMejor} {negocio.telefono}</a>
            </div>
          </aside>
        </form>

        <div class="ok" data-ok hidden tabindex="-1">
          <p class="ok-title"><Icon name="check" size={22} />{t.cita.okTitulo}</p>
          <p class="ok-summary" data-ok-summary></p>
          <p>{t.cita.okTexto}</p>
          <div class="ok-actions">
            <button type="button" class="btn btn-gold" data-ics><Icon name="calendar" size={20} />{t.cita.calendario}</button>
            <a class="btn btn-line" data-reopen href={wa} target="_blank" rel="noopener"><Icon name="chat" size={20} />{t.cita.abrirDeNuevo}</a>
            <button type="button" class="linkish" data-reset>{t.cita.otra}</button>
          </div>
        </div>
      </div>
    </section>

    <!-- Precios: la carta del escaparate -->
    <section id="servicios" class="prices" aria-labelledby="precios-title">
      <div class="wrap">
        <div class="sec-head sec-head-center" data-reveal>
          <h2 id="precios-title">{t.servicios.titulo}</h2>
          <p class="orn-line" aria-hidden="true"><span class="orn"></span><span class="orn"></span></p>
          <p>{t.servicios.intro}</p>
        </div>
        <div class="price-cols">
          {grupos.map((g, i) => (
            <div class="price-group" data-reveal style={`--d:${i * 90}ms`}>
              <h3>{t.servicios.grupos[g]}</h3>
              <ul>
                {servicios.filter((s) => s.grupo === g).map((s) => (
                  <li>
                    <a href="#cita" data-pick={s.id} class:list={['price-row', { 'has-price': s.precio != null }]}>
                      <span class="pr-name">{t.servicios.nombres[s.id]}</span>
                      <span class="pr-dots" aria-hidden="true"></span>
                      <span class="pr-price">{precio(s.precio) ?? t.servicios.consultar}</span>
                      <span class="pr-go">{t.servicios.reservar}<Icon name="arrow" size={15} /></span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
        <p class="note note-center">{t.servicios.ejemplo}</p>
      </div>
    </section>

    <!-- Trabajos: la pared de papel pintado negro y oro -->
    <section id="trabajos" class="works" aria-labelledby="trabajos-title">
      <div class="wrap">
        <div class="sec-head works-head" data-reveal>
          <h2 id="trabajos-title">{t.trabajos.titulo}</h2>
          <p>{t.trabajos.intro}</p>
          <a class="btn btn-line btn-sm" href={ig} target="_blank" rel="noopener"><Icon name="instagram" size={18} />{t.trabajos.instagram}</a>
        </div>
        <ul class="gallery">
          <li class="g-item g-ba" data-reveal-mask>
            <div class="ba" data-ba style="--x:50%">
              <img class="ba-after" src={foto('antes-despues')} alt={t.trabajos.alts['antes-despues']} width="900" height="900" loading="lazy" decoding="async" />
              <img class="ba-before" src={foto('antes-despues')} alt="" width="900" height="900" loading="lazy" decoding="async" />
              <span class="ba-tag ba-tag-l" aria-hidden="true">{t.trabajos.antes}</span>
              <span class="ba-tag ba-tag-r" aria-hidden="true">{t.trabajos.despues}</span>
              <span class="ba-handle" aria-hidden="true"><Icon name="arrow" size={16} /><Icon name="arrow" size={16} /></span>
              <input class="ba-range" type="range" min="0" max="100" value="50" aria-label={t.trabajos.comparar} data-ba-range />
            </div>
          </li>
          {galeria.map((id, i) => (
            <li class={`g-item g-${i}`} data-reveal-mask style={`--d:${(i + 1) * 70}ms`}>
              <button type="button" class="g-open" data-lb-open={i} aria-label={`${t.trabajos.ampliar}: ${t.trabajos.alts[id]}`}>
                <Pic id={id} alt={t.trabajos.alts[id]} sizes="(max-width: 760px) 50vw, 25vw" />
              </button>
            </li>
          ))}
        </ul>
        <dialog class="lb" data-lb aria-label={t.trabajos.titulo} data-fotos={JSON.stringify(galeria.map((id) => ({ src: foto(id), alt: t.trabajos.alts[id] })))}>
          <figure class="lb-fig">
            <img data-lb-img src={foto(galeria[0])} alt="" loading="lazy" />
            <figcaption data-lb-cap></figcaption>
          </figure>
          <button type="button" class="lb-btn lb-close" data-lb-close aria-label={t.trabajos.cerrar}><span aria-hidden="true" class="x"></span></button>
          <button type="button" class="lb-btn lb-prev" data-lb-prev aria-label={t.trabajos.anterior}><Icon name="arrow" size={22} /></button>
          <button type="button" class="lb-btn lb-next" data-lb-next aria-label={t.trabajos.siguiente}><Icon name="arrow" size={22} /></button>
        </dialog>
      </div>
    </section>

    <!-- Reseñas reales -->
    <section class="reviews" aria-labelledby="resenas-title">
      <div class="wrap">
        <div class="reviews-head">
          <h2 id="resenas-title">{t.resenas.titulo}</h2>
          <a class="rev-score" href={negocio.mapsUrl} target="_blank" rel="noopener">
            <span class="rev-num" data-count={v.nota}>{v.nota}</span>
            <span class="rev-meta">
              <span class="stars" aria-hidden="true">{[0, 1, 2, 3, 4].map(() => <Icon name="star" size={16} />)}</span>
              <span>{fill(t.resenas.media, { x: v.nota, n: v.resenas })}</span>
              <span class="rev-link">{t.resenas.ver}<Icon name="arrow" size={15} /></span>
            </span>
          </a>
        </div>
        <ul class="quotes">
          {resenas.filter((_, i) => i !== 1).map((r, i) => (
            <li data-reveal style={`--d:${i * 80}ms`}>
              <blockquote lang={r.lang}>
                <p>“{r.t}”</p>
                <footer>{r.n}</footer>
              </blockquote>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="faq" aria-labelledby="faq-title">
      <div class="wrap faq-in">
        <h2 id="faq-title">{t.faq.titulo}</h2>
        <div class="faq-list">
          {t.faq.items.map((it) => (
            <details>
              <summary>{it.q}<Icon name="arrow" size={18} /></summary>
              <p>{it.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- Visita: fachada, horario y mapa -->
    <section id="visita" class="visit" aria-labelledby="visita-title">
      <div class="wrap visit-in">
        <div class="visit-info">
          <h2 id="visita-title">{t.visita.titulo}</h2>
          <p class="status" data-status-full></p>
          <table class="hours">
            <caption class="sr">{t.visita.horario}</caption>
            <tbody>
              {ordenDias.map((d) => (
                <tr data-day={d}>
                  <th scope="row">{cap(t.dias[d])}<span class="today-tag">{t.visita.hoy}</span></th>
                  <td>{horario[d].length ? tramosTexto(d) : t.visita.cerradoDia}</td>
                </tr>
              ))}
            </tbody>
          </table>
          <div class="addr">
            <p><Icon name="pin" size={20} /><span>{negocio.direccion.calle}<br />{negocio.direccion.cp} {negocio.direccion.ciudad}</span></p>
            <div class="addr-actions">
              <a class="btn btn-dark" href={negocio.mapsUrl} target="_blank" rel="noopener"><Icon name="route" size={20} />{t.visita.comoLlegar}</a>
              <a class="btn btn-dark-line" href={tel}><Icon name="phone" size={20} />{negocio.telefono}</a>
            </div>
          </div>
        </div>
        <div class="visit-media">
          <figure class="facade" data-reveal>
            <Pic id="fachada" alt={t.trabajos.alts.fachada} sizes="(max-width: 860px) 92vw, 560px" />
            <figcaption>{t.visita.buscanos}</figcaption>
          </figure>
          <div class="map">
            <iframe src={negocio.mapsEmbed} title={t.visita.mapaTitulo} loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
          </div>
        </div>
      </div>
    </section>
  </main>

  <footer class="foot">
    <div class="wrap foot-in">
      <div class="foot-cta">
        <p class="foot-logo" aria-hidden="true">Sempre Divas</p>
        <p class="foot-big">{t.pie.cta}</p>
        <p>{t.pie.ctaSub}</p>
        <a class="btn btn-gold" href="#cita"><Icon name="calendar" size={20} />{t.pedirCita}</a>
      </div>
      <div class="foot-cols">
        <div>
          <p class="foot-h">{t.pie.donde}</p>
          <p>{negocio.direccion.calle}<br />{negocio.direccion.cp} {negocio.direccion.ciudad}</p>
        </div>
        <div>
          <p class="foot-h">{t.pie.contacto}</p>
          <p>
            <a href={tel}>{negocio.telefono}</a> · <a href={wa} target="_blank" rel="noopener">WhatsApp</a><br />
            {t.pie.fijo}: <a href={`tel:${negocio.fijoE164}`}>{negocio.fijo}</a><br />
            <a href={ig} target="_blank" rel="noopener">@{negocio.instagram}</a>
          </p>
        </div>
        <div>
          <p class="foot-h">{t.pie.horario}</p>
          <p>{horarioAgrupado.map((h) => <>{h.dias}: {h.horas}<br /></>)}</p>
        </div>
      </div>
      <p class="foot-bottom">
        <span>{t.oficio} · {t.pie.hecho}</span>
        <a href="#main">{t.pie.arriba}</a>
      </p>
    </div>
  </footer>

  <nav class="dock" aria-label={t.pedirCita}>
    <a href={tel}><Icon name="phone" size={20} />{t.llamar}</a>
    <a href={wa} target="_blank" rel="noopener"><Icon name="chat" size={20} />{t.whatsapp}</a>
    <a href="#cita" class="dock-main"><Icon name="calendar" size={20} />{t.pedirCita}</a>
  </nav>
</div>

<script>
  import { init } from '../scripts/app';
  import { efectos } from '../scripts/efectos';
  init();
  efectos();
</script>
