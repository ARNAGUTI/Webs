---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import { ui, type Lang } from '../i18n/ui';
import { negocio, horario, lineas, servicios, largos } from '../data/negocio';

import imgSalon from '../assets/img/salon.jpg';
import imgPatri from '../assets/img/patri.jpg';
import imgFachada from '../assets/img/fachada.jpg';
import imgProductos from '../assets/img/productos.jpg';
import imgBalayage from '../assets/img/balayage.jpg';
import imgCastano from '../assets/img/castano.jpg';
import imgOndas from '../assets/img/ondas.jpg';
import imgTrenza from '../assets/img/trenza.jpg';
import imgTrenzasNuca from '../assets/img/trenzas-nuca.jpg';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang];
const r = t.ruta;
const other: Lang = lang === 'es' ? 'ca' : 'es';
const hrefFor = (l: Lang) => (l === 'es' ? '/' : '/ca/');
const tel = `tel:${negocio.telefonoE164}`;
const v = negocio.valoracion;
const fill = (tpl: string, vars: Record<string, string | number>) => tpl.replace(/\{(\w)\}/g, (_, k) => String(vars[k] ?? ''));
const precio = (p: number) => (p ? fill(t.lineas.desde, { p }) : t.lineas.gratis);

// Trabajos: el primero va grande. object-position recorta el icono de Instagram del balayage.
const trabajos = [
  { key: 'balayage', src: imgBalayage, pos: '50% 20%' },
  { key: 'castano', src: imgCastano, pos: '50% 40%' },
  { key: 'trenzas-nuca', src: imgTrenzasNuca, pos: '60% 45%' },
  { key: 'trenza', src: imgTrenza, pos: '50% 30%' },
  { key: 'ondas', src: imgOndas, pos: '50% 35%' },
] as const;

const ordenDias = [1, 2, 3, 4, 5, 6, 0];
const tramosTexto = (d: number) => horario[d].map(([a, b]) => `${a} – ${b}`).join(' · ');
const cap = (x: string) => x.charAt(0).toUpperCase() + x.slice(1);
// Horario compacto para el cartel de la puerta: días seguidos con las mismas horas van juntos.
const horarioPuerta: { dias: string; horas: string }[] = [];
for (let i = 0; i < ordenDias.length; ) {
  const d = ordenDias[i];
  let j = i;
  while (j + 1 < ordenDias.length && tramosTexto(ordenDias[j + 1]) === tramosTexto(d)) j++;
  if (horario[d].length) {
    horarioPuerta.push({ dias: i === j ? cap(t.diasCortos[d]) : `${cap(t.diasCortos[d])} – ${cap(t.diasCortos[ordenDias[j]])}`, horas: tramosTexto(d) });
  }
  i = j + 1;
}

const estaciones = ['destino', 'pelo', 'largo', 'hora', 'datos'] as const;

const cliente = {
  lang,
  horario,
  whatsapp: negocio.whatsapp,
  servicios: servicios.map((s) => ({ id: s.id, linea: s.linea, min: s.min, desde: s.desde, nombre: t.servicios.nombres[s.id] })),
  lineas: lineas.map((l) => ({ id: l.id, num: l.num, nombre: t.lineas.nombres[l.id] })),
  largos: largos.map((l) => ({ id: l.id, cm: l.cm, nombre: t.ruta.largo.nombres[l.id] })),
  negocio: { nombre: negocio.nombre, direccion: `${negocio.direccion.calle}, ${negocio.direccion.cp} ${negocio.direccion.ciudad}` },
  t: {
    dias: t.dias, diasCortos: t.diasCortos, meses: t.meses, hoy: t.hoy, manana: t.manana,
    ruta: r, hero: t.hero, visita: t.visita, desde: t.lineas.desde, gratis: t.lineas.gratis,
  },
};
---
<a class="skip" href="#contenido">{t.skip}</a>

<header class="top" data-top>
  <a class="top-logo" href={hrefFor(lang)} aria-label={negocio.nombre}><Logo sub={false} /></a>
  <nav class="nav" aria-label="Menú">
    <a href="#patri">{t.nav.patri}</a>
    <a href="#servicios">{t.nav.servicios}</a>
    <a href="#trabajos">{t.nav.trabajos}</a>
    <a href="#visita">{t.nav.visita}</a>
  </nav>
  <div class="top-actions">
    <a class="lang" href={hrefFor(other)} hreflang={other} lang={other} data-lang>{other.toUpperCase()}</a>
    <a class="top-tel" href={tel} aria-label={`${t.llamar} ${negocio.telefono}`}><Icon name="phone" size={18} /><span>{negocio.telefono}</span></a>
    <a class="btn btn-rose btn-sm top-cta" href="#cita">{t.nav.cita}</a>
  </div>
</header>

<main id="app" data-cliente={JSON.stringify(cliente)}>
  <span id="contenido" tabindex="-1"></span>

  <!-- La fachada: el rótulo iluminado y el escaparate -->
  <section class="fachada">
    <div class="rotulo">
      <span class="focos" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
      <Logo tag="h1" class="logo-hero" />
    </div>

    <div class="escaparate">
      <div class="puerta">
        <p class="puerta-estado" data-open>
          <span class="open-dot" aria-hidden="true"></span>
          <b data-open-word>{t.hero.abierto}</b>
          <span data-status></span>
        </p>
        <p class="puerta-lema">{t.hero.lema}</p>
        <div class="puerta-cta">
          <a class="btn btn-rose" href="#cita"><Icon name="calendar" size={20} />{t.hero.cta}</a>
          <a class="btn btn-line" href={tel}><Icon name="phone" size={18} />{negocio.telefono}</a>
        </div>
        <dl class="puerta-horario">
          {horarioPuerta.map((h) => (<div><dt>{h.dias}</dt><dd>{h.horas}</dd></div>))}
        </dl>
        <a class="puerta-rating" href={negocio.mapsUrl} target="_blank" rel="noopener">
          <span class="stars" aria-hidden="true">{[1, 2, 3, 4, 5].map(() => <Icon name="star" size={15} />)}</span>
          <b>{v.nota}</b> · {fill(t.hero.resenas, { n: v.resenas })} Google
        </a>
        <p class="puerta-dir"><Icon name="pin" size={16} />{t.hero.lugar}</p>
      </div>
      <figure class="cristal">
        <Image src={imgSalon} alt={t.hero.escaparate} widths={[640, 960, 1280, 1600]} sizes="(max-width: 860px) 100vw, 68vw" loading="eager" fetchpriority="high" />
      </figure>
    </div>
    <div class="zocalo" aria-hidden="true"></div>
  </section>

  <!-- Patri -->
  <section class="patri" id="patri">
    <div class="wrap patri-grid">
      <figure class="marco marco-alto">
        <Image src={imgPatri} alt={t.patri.foto} widths={[400, 600, 800]} sizes="(max-width: 860px) 90vw, 36vw" />
      </figure>
      <div class="patri-texto">
        <h2 class="h2">{t.patri.titulo}</h2>
        <p class="lead">{t.patri.texto}</p>
        <ul class="claves" role="list">
          {t.patri.claves.map((c) => (<li><h3>{c.t}</h3><p>{c.d}</p></li>))}
        </ul>
      </div>
    </div>
  </section>

  <!-- La cita -->
  <section class="cita" id="cita">
    <div class="wrap">
      <h2 class="h2">{r.titulo}</h2>
      <p class="intro">{r.intro}</p>

      <p class="resume" data-resume hidden>
        <Icon name="flag" size={18} /><span>{r.guardado}</span>
        <button type="button" class="link-btn" data-empezar>{r.empezar}</button>
      </p>

      <nav class="pasos" aria-label={r.titulo}>
        <svg class="pasos-trazo" viewBox="0 0 1000 24" preserveAspectRatio="none" aria-hidden="true">
          <path class="pasos-base" d="M10 14 C 250 4, 500 22, 750 10 S 990 12, 990 12" />
          <path class="pasos-hecho" d="M10 14 C 250 4, 500 22, 750 10 S 990 12, 990 12" pathLength="1" />
        </svg>
        <ol class="pasos-lista" role="list" data-map>
          {estaciones.map((e, i) => (
            <li data-stop={e}>
              <a href={`#st-${e}`}>
                <span class="paso-num" aria-hidden="true">{i + 1}</span>
                <span class="paso-name">{r.estaciones[e]}</span>
              </a>
              <span class="paso-flag" aria-hidden="true">{r.dejaste}</span>
            </li>
          ))}
        </ol>
      </nav>

      <form class="cita-form" data-ruta novalidate>
        <div class="stations">
          <fieldset class="station" id="st-destino" data-station="destino">
            <legend><span class="st-num" aria-hidden="true">1</span>{r.destino.linea}</legend>
            <div class="chips chips-lines">
              {lineas.map((l) => (
                <label class="chip chip-line"><input type="radio" name="linea" value={l.id} /><span>{t.lineas.nombres[l.id]}</span></label>
              ))}
            </div>
            <p class="sub-q">{r.destino.servicio}</p>
            <div class="svc-list" data-svcs>
              {servicios.map((s) => (
                <label class="svc" data-linea={s.linea}>
                  <input type="radio" name="servicio" value={s.id} />
                  <span class="svc-body"><b>{t.servicios.nombres[s.id]}</b><small>{t.servicios.detalles[s.id]}</small></span>
                  <span class="svc-meta"><b>{precio(s.desde)}</b><small>{fill(t.lineas.min, { m: s.min })}</small></span>
                </label>
              ))}
            </div>
            <p class="err" data-err="servicio" aria-live="polite"></p>
          </fieldset>

          <fieldset class="station" id="st-pelo" data-station="pelo">
            <legend><span class="st-num" aria-hidden="true">2</span>{r.pelo.tipo}</legend>
            <div class="chips">
              {Object.entries(r.pelo.tipos).map(([k, label]) => (
                <label class="chip"><input type="radio" name="pelo" value={k} /><span>{label}</span></label>
              ))}
            </div>
            <p class="sub-q">{r.pelo.estado}</p>
            <div class="chips">
              {Object.entries(r.pelo.estados).map(([k, label]) => (
                <label class="chip chip-check"><input type="checkbox" name="estado" value={k} /><span><Icon name="check" size={16} />{label}</span></label>
              ))}
            </div>
            <p class="err" data-err="pelo" aria-live="polite"></p>
          </fieldset>

          <fieldset class="station" id="st-largo" data-station="largo">
            <legend><span class="st-num" aria-hidden="true">3</span>{r.largo.pregunta}</legend>
            <p class="hint">{r.largo.ayuda}</p>
            <p class="hint" data-largo-na hidden>{r.largo.noAplica}</p>
            <div class="largo" data-largo>
              <div class="largo-head" aria-hidden="true"><span></span><span>{r.largo.ahora}</span><span>{r.largo.quiero}</span></div>
              {largos.map((l) => (
                <div class="largo-row" data-largo-row={l.id}>
                  <span class="largo-name" id={`lg-${l.id}`}>{r.largo.nombres[l.id]}</span>
                  <label class="largo-pick"><input type="radio" name="ahora" value={l.id} aria-labelledby={`lg-${l.id} ah-l`} /><span class="pick pick-now" aria-hidden="true"></span></label>
                  <label class="largo-pick"><input type="radio" name="quiero" value={l.id} aria-labelledby={`lg-${l.id} qu-l`} /><span class="pick pick-want" aria-hidden="true"></span></label>
                </div>
              ))}
              <span id="ah-l" hidden>{r.largo.ahora}</span>
              <span id="qu-l" hidden>{r.largo.quiero}</span>
            </div>
            <p class="largo-msg" data-largo-msg aria-live="polite"></p>
            <label class="check"><input type="checkbox" name="foto" /><span><Icon name="camera" size={18} />{r.largo.foto}</span></label>
            <p class="err" data-err="largo" aria-live="polite"></p>
          </fieldset>

          <fieldset class="station" id="st-hora" data-station="hora">
            <legend><span class="st-num" aria-hidden="true">4</span>{r.estaciones.hora}</legend>
            <div class="chips chips-days" data-days></div>
            <p class="err" data-err="dia" aria-live="polite"></p>
            <div class="chips chips-slots" data-slots><p class="hint">{r.hora.eligeDia}</p></div>
            <p class="err" data-err="hora" aria-live="polite"></p>
            <p class="hint small">{r.comoFunciona}</p>
          </fieldset>

          <fieldset class="station" id="st-datos" data-station="datos">
            <legend><span class="st-num" aria-hidden="true">5</span>{r.estaciones.datos}</legend>
            <p class="hola" data-hola hidden><span data-hola-text></span> <button type="button" class="link-btn" data-olvidar>{r.datos.noSoy}</button></p>
            <div class="fields">
              <label class="field"><span>{r.datos.nombre}</span><input name="nombre" autocomplete="given-name" maxlength="40" /><em class="err" data-err="nombre" aria-live="polite"></em></label>
              <label class="field"><span>{r.datos.tel}</span><input name="tel" type="tel" inputmode="tel" autocomplete="tel" maxlength="16" /><em class="err" data-err="tel" aria-live="polite"></em></label>
              <label class="field field-wide"><span>{r.datos.nota}</span><input name="nota" maxlength="140" placeholder={r.datos.notaPh} /></label>
            </div>
            <label class="check"><input type="checkbox" name="recordar" checked /><span>{r.datos.recordar}</span></label>
          </fieldset>
        </div>

        <aside class="ficha" data-ficha aria-live="polite">
          <div class="ficha-head"><Logo sub={false} /><span>{r.ficha}</span></div>
          <div class="ficha-body">
            <p class="ficha-fam" data-ficha-badge></p>
            <p class="ficha-svc" data-ficha-svc>{r.fichaVacia}</p>
            <dl class="ficha-dl">
              <div><dt>{r.estaciones.pelo}</dt><dd data-f="pelo">—</dd></div>
              <div><dt>{r.estaciones.largo}</dt><dd data-f="largo">—</dd></div>
              <div><dt>{r.estaciones.hora}</dt><dd data-f="hora">—</dd></div>
            </dl>
            <p class="ficha-precio"><b data-f="precio">—</b><small>{r.precioOrientativo}</small></p>
            <button class="btn btn-rose btn-block" type="submit"><Icon name="chat" size={20} />{r.enviar}</button>
            <p class="ficha-call">{r.llamarMejor}<a href={tel}>{negocio.telefono}</a></p>
          </div>
        </aside>
      </form>

      <div class="ok" data-ok hidden tabindex="-1">
        <p class="ok-t"><Icon name="check" size={22} />{r.okTitulo}</p>
        <p class="ok-sum" data-ok-summary></p>
        <p>{r.okTexto}</p>
        <div class="ok-actions">
          <button type="button" class="btn btn-rose" data-ics><Icon name="calendar" size={18} />{r.calendario}</button>
          <a class="btn btn-line" data-reopen href="#" target="_blank" rel="noopener"><Icon name="chat" size={18} />{r.abrirDeNuevo}</a>
          <button type="button" class="link-btn" data-reset>{r.otra}</button>
        </div>
      </div>
    </div>
  </section>

  <!-- Servicios -->
  <section class="servicios" id="servicios">
    <div class="wrap">
      <h2 class="h2">{t.lineas.titulo}</h2>
      <p class="intro">{t.lineas.intro}</p>
      <div class="carta">
        {lineas.map((l) => (
          <div class="carta-grupo">
            <h3>{t.lineas.nombres[l.id]}</h3>
            <ul role="list">
              {servicios.filter((s) => s.linea === l.id).map((s) => (
                <li>
                  <a href="#cita" data-pick={s.id}>
                    <span class="c-name">{t.servicios.nombres[s.id]}<small>{fill(t.lineas.min, { m: s.min })}</small></span>
                    <span class="c-dots" aria-hidden="true"></span>
                    <span class="c-price">{precio(s.desde)}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Trabajos reales -->
  <section class="trabajos" id="trabajos">
    <div class="wrap">
      <h2 class="h2">{t.trabajos.titulo}</h2>
      <p class="intro">{t.trabajos.intro}</p>
      <ul class="galeria" role="list">
        {trabajos.map((g, i) => (
          <li class={`g g${i + 1}`}>
            <Image src={g.src} alt={t.trabajos.alts[g.key]} widths={[360, 540, 720, 960]} sizes={i === 0 ? '(max-width: 860px) 100vw, 40vw' : '(max-width: 860px) 50vw, 28vw'} style={`object-position:${g.pos}`} />
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Productos -->
  <section class="productos">
    <div class="wrap productos-grid">
      <div>
        <h2 class="h2">{t.productos.titulo}</h2>
        <p class="lead">{t.productos.texto}</p>
      </div>
      <figure class="marco">
        <Image src={imgProductos} alt={t.productos.foto} widths={[480, 720, 960]} sizes="(max-width: 860px) 90vw, 46vw" />
      </figure>
    </div>
  </section>

  <section class="opiniones" id="opiniones">
    <div class="wrap">
      <div class="op-head">
        <h2 class="h2">{t.opiniones.titulo}</h2>
        <p class="op-score"><span class="op-n">{v.nota}</span><span class="stars" aria-hidden="true">{[1, 2, 3, 4, 5].map(() => <Icon name="star" size={20} />)}</span><span>{fill(t.opiniones.nota, { v: v.nota, n: v.resenas })}</span></p>
      </div>
      <ul class="quotes" role="list">
        {t.opiniones.lista.map((o) => (<li><blockquote lang="es"><p>{o.q}</p></blockquote><cite>{o.a}</cite></li>))}
      </ul>
      <a class="btn btn-line-dark" href={negocio.mapsUrl} target="_blank" rel="noopener">{t.opiniones.ver}<Icon name="arrow" size={18} /></a>
    </div>
  </section>

  <section class="visita" id="visita">
    <div class="wrap visita-grid">
      <figure class="marco visita-foto">
        <Image src={imgFachada} alt={t.visita.fachada} widths={[480, 720, 960]} sizes="(max-width: 860px) 90vw, 40vw" />
      </figure>
      <div>
        <h2 class="h2">{t.visita.titulo}</h2>
        <p class="status-line" data-status-line></p>
        <table class="hours">
          <tbody>
            {ordenDias.map((d) => (
              <tr data-day={d}><th scope="row">{cap(t.dias[d])}</th><td>{horario[d].length ? tramosTexto(d) : t.visita.cerradoDia}</td></tr>
            ))}
          </tbody>
        </table>
        <ul class="facts" role="list">
          <li><Icon name="pin" size={20} />{negocio.direccion.calle}, {negocio.direccion.cp} {negocio.direccion.ciudad}</li>
          <li><Icon name="metro" size={20} />{t.visita.metro}</li>
          <li><Icon name="access" size={20} />{t.visita.datos[1]}</li>
          <li><Icon name="card" size={20} />{t.visita.datos[2]}</li>
        </ul>
        <div class="visita-actions">
          <a class="btn btn-rose" href={negocio.mapsUrl} target="_blank" rel="noopener"><Icon name="route" size={18} />{t.visita.comoLlegar}</a>
          <a class="btn btn-line-dark" href={tel}><Icon name="phone" size={18} />{negocio.telefono}</a>
        </div>
        <div class="mapbox" data-mapbox data-src={negocio.mapsEmbed} data-title={negocio.nombre}>
          <button type="button" class="map-load" data-map-load><Icon name="pin" size={22} /><b>{t.visita.verMapa}</b><small>{t.visita.mapaAviso}</small></button>
        </div>
      </div>
    </div>
  </section>

  <section class="faq" aria-labelledby="faq-t">
    <div class="wrap">
      <h2 class="h2" id="faq-t">{t.faq.titulo}</h2>
      <div class="faq-list">
        {t.faq.lista.map((f) => (<details><summary>{f.q}</summary><p>{f.a}</p></details>))}
      </div>
    </div>
  </section>
</main>

<footer class="pie">
  <div class="pie-rotulo"><Logo /></div>
  <div class="wrap pie-in">
    <p>{negocio.direccion.calle}, {negocio.direccion.cp} {negocio.direccion.ciudad} · <a href={tel}>{negocio.telefono}</a></p>
    <p><a href={lang === 'es' ? '/legal/' : '/ca/legal/'}>{t.pie.legal}</a> · <a href={hrefFor(other)} hreflang={other} lang={other} data-lang>{other === 'ca' ? 'Català' : 'Español'}</a></p>
  </div>
</footer>

<div class="dock">
  <a class="btn btn-line" href={tel}><Icon name="phone" size={18} />{t.llamar}</a>
  <a class="btn btn-rose" href="#cita"><Icon name="calendar" size={18} />{t.nav.cita}</a>
</div>

<script>
  import { init } from '../scripts/app';
  init();
</script>
