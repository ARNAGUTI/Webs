---
// El rótulo de la fachada: MILANO en blanco, el trazo rosa sobre la A y
// PERRUQUERIA en versales espaciadas debajo.
interface Props { sub?: boolean; class?: string; tag?: 'span' | 'h1' | 'p' }
const { sub = true, class: cls = '', tag: Tag = 'span' } = Astro.props;
---
<Tag class={`logo ${cls}`}>
  <span class="logo-word" aria-hidden="true">MIL<span class="logo-a">A<svg class="logo-trazo" viewBox="0 0 60 100" preserveAspectRatio="none" focusable="false"><path d="M1 100 C 9 70, 22 31, 57 -6 C 33 30, 20 67, 13 100 Z" /></svg></span>NO</span>
  {sub && <span class="logo-sub" aria-hidden="true">Perruqueria</span>}
  <span class="sr-only">Milano Perruqueria</span>
</Tag>
