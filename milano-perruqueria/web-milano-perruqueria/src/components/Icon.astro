---
// Iconos dibujados a mano, mismo trazo (1.8) y caja 24.
interface Props { name: 'phone' | 'chat' | 'pin' | 'clock' | 'arrow' | 'star' | 'route' | 'check' | 'calendar' | 'card' | 'flag' | 'camera' | 'metro' | 'access'; size?: number; class?: string }
const { name, size = 22, class: cls = '' } = Astro.props;
---
<svg class={`icon ${cls}`} width={size} height={size} viewBox="0 0 24 24" aria-hidden="true" focusable="false"
  fill={name === 'star' ? 'currentColor' : 'none'} stroke={name === 'star' ? 'none' : 'currentColor'}
  stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
  {name === 'phone' && <path d="M5 3.5h3.2l1.6 4.3-2.1 1.4a11 11 0 0 0 7.1 7.1l1.4-2.1 4.3 1.6V19a1.8 1.8 0 0 1-1.9 1.8C10.6 20.3 3.7 13.4 3.2 5.4A1.8 1.8 0 0 1 5 3.5Z" />}
  {name === 'chat' && <><path d="M4.3 19.7 5.4 16A8.3 8.3 0 1 1 8.4 19l-4.1.7Z" /><path d="M9.2 9.6c.3 2 1.8 3.6 3.9 4.3l1.2-1.1 1.6.8c-.2 1-1 1.6-2 1.5-3-.3-5.6-2.9-5.9-5.9-.1-1 .5-1.8 1.5-2l.8 1.6-1.1.8Z" stroke-width="1.4" /></>}
  {name === 'pin' && <><path d="M12 21s-6.5-6.1-6.5-11a6.5 6.5 0 0 1 13 0c0 4.9-6.5 11-6.5 11Z" /><circle cx="12" cy="10" r="2.4" /></>}
  {name === 'clock' && <><circle cx="12" cy="12" r="8.5" /><path d="M12 7.5V12l3 2" /></>}
  {name === 'arrow' && <path d="M4.5 12h14m-5.5-6 6 6-6 6" />}
  {name === 'route' && <><circle cx="6" cy="18" r="2" /><circle cx="18" cy="6" r="2" /><path d="M8 18h7.5a3.5 3.5 0 0 0 0-7h-7a3.5 3.5 0 0 1 0-7H16" /></>}
  {name === 'check' && <path d="m5 12.5 4.5 4.5L19 7.5" />}
  {name === 'calendar' && <><rect x="3.5" y="5" width="17" height="15.5" rx="2.5" /><path d="M3.5 10h17M8 3v4m8-4v4" /></>}
  {name === 'card' && <><rect x="3" y="5.5" width="18" height="13" rx="2.5" /><path d="M3 10h18M7 15h4" /></>}
  {name === 'flag' && <path d="M6 21V4m0 1h11l-2.5 4L17 13H6" />}
  {name === 'camera' && <><path d="M4 8.5A1.5 1.5 0 0 1 5.5 7h2l1.5-2h6l1.5 2h2A1.5 1.5 0 0 1 20 8.5v9a1.5 1.5 0 0 1-1.5 1.5h-13A1.5 1.5 0 0 1 4 17.5v-9Z" /><circle cx="12" cy="13" r="3.3" /></>}
  {name === 'metro' && <><rect x="3.5" y="3.5" width="17" height="17" rx="2" /><path d="M8 16.5v-9l4 5 4-5v9" /></>}
  {name === 'access' && <><circle cx="11" cy="4.6" r="1.6" /><path d="M11 7.5v6h5l2 5.5M11 10.5h5" /><path d="M8.2 11.3a5.3 5.3 0 1 0 7.3 6.6" /></>}
  {name === 'star' && <path d="m12 2.8 2.7 5.9 6.4.7-4.8 4.3 1.4 6.3L12 16.8 6.3 20l1.4-6.3L2.9 9.4l6.4-.7L12 2.8Z" />}
</svg>
